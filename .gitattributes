# ============================================================
#  换行符规则
#
#  背景：Windows 上 git 的 core.autocrlf=true 会在检出时把 LF 转成 CRLF。
#  这对 Markdown 无所谓，但【shell 脚本一旦变成 CRLF，在 Linux 上执行会报错】：
#      bash: ./script.sh: /bin/bash^M: bad interpreter
#
#  所以这里显式声明：shell 脚本永远用 LF，不受本地设置影响。
# ============================================================

# Shell 脚本必须用 LF
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf

# Linux 配置文件
*.service   text eol=lf
*.conf      text eol=lf

# 其他文本文件统一 LF（Markdown / JSON / YAML）
*.md        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.example   text eol=lf

# PowerShell 脚本用 CRLF（Windows 惯例）
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# 二进制文件不做转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.gz        binary
*.pdf       binary
